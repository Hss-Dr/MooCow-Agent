
# nginx
NGINX_DATA_PATH=/home/ubuntu
FRONTEND_PAGE=/home/ubuntu

# es (密码需与docker-compose.yml中gsk-es-01容器的ELASTIC_PASSWORD一致)
ELASTIC_PASSWORD="your-value-here"
STACK_VERSION=8.11.3
MEM_LIMIT=8073741824
TIMEZONE='Asia/Shanghai'

# 模型配置
DASHSCOPE_API_KEY="your-value-here"
DASHSCOPE_BASE_URL="https://api.siliconflow.cn/v1"
# 主对话模型（带思考推理，用于流式回答）
CHAT_MODEL="deepseek-ai/DeepSeek-R1"
# 辅助任务模型（推荐问题、会话命名等，更快更省）
UTIL_MODEL="deepseek-ai/DeepSeek-V3"
# 向量嵌入模型（SiliconFlow上需带BAAI/前缀，1024维，不支持dimensions参数）
EMBEDDING_MODEL="BAAI/bge-m3"
# Rerank 精排模型（SiliconFlow /v1/rerank，兼容 Cohere 格式；用于 RRF 粗排后 top20→5 的语义重排）
# 走此模型失败时会自动降级到本地 hybrid_similarity（0.4×词项+0.6×余弦），检索不中断。
RERANK_MODEL="Pro/BAAI/bge-reranker-v2-m3"

# 混合知识库配置
# 公共共享库的 ES 索引名（全公司共享，所有人可检索，仅管理员可上传）
SHARED_KB_INDEX="company_kb"
# 管理员白名单：可上传到公共库的 user_id，逗号分隔（此处为登录用户的 JWT user_id，即 users 表主键 id）
# 生产环境请改成真实管理员的 user_id；下面 8=test2 仅用于自测
ADMIN_USER_IDS="8"

# JWT认证（与backend共享同一密钥，缺省时服务会拒绝启动）
JWT_SECRET_KEY="your-value-here"

# 数据库配置
DATABASE_URL=postgresql://postgres:pg123456@gsk_pg:5432/gsk

# Elasticsearch配置
ES_HOST=http://es01:9200
