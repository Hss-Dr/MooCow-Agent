# 复制本文件为 .env 并填入真实密钥
# ============================================================

# LLM配置（硅基流动）
SF_API_KEY=your-siliconflow-api-key
SF_BASE_URL=https://api.siliconflow.cn/v1
# 主模型（推理/思考，用于主调度与复杂推理）
MAIN_MODEL_NAME=deepseek-ai/DeepSeek-V4-Pro
# 快速模式模型（关闭深度思考时使用，无推理过程）
FAST_MODEL_NAME=deepseek-ai/DeepSeek-V3

AL_BAILIAN_API_KEY=your-siliconflow-api-key
AL_BAILIAN_BASE_URL=https://api.siliconflow.cn/v1
# 子模型（通用/干活，用于工具调用与子智能体）
SUB_MODEL_NAME=deepseek-ai/DeepSeek-V4-Pro

# PostgreSQL配置（本机裸跑用；容器内由 docker-compose 覆盖为容器地址）
DATABASE_URL=postgresql://postgres:pg123456@localhost:5432/gsk

# JWT认证（与RAG服务共享密钥，务必修改）
JWT_SECRET_KEY=change-me

# MCP配置
# MCP 通用联网搜索的url
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
# 通义千问 DashScope API Key
DASHSCOPE_API_KEY=your-dashscope-api-key
# 百度地图 AK（导航功能，需申请）
BAIDUMAP_AK=your-baidu-map-ak

# RAG服务配置
RAG_SERVICE_URL=http://127.0.0.1:8001
RAG_SERVICE_TIMEOUT=60
RAG_DEFAULT_USER_ID=default_user

# default_user 默认密码（仅首次创建时使用）
DEFAULT_USER_PASSWORD=change-me
