# ============================================
# MooCow-Agent - 可选环境变量覆盖
# ============================================
# docker-compose.yml 中所有 ${VAR} 均有默认值，
# 本文件（根目录 .env）通常不需要创建。
# 如需覆盖默认值，复制为 .env 并修改。
# 真正的密钥配置在：
#   backend/.env         （LLM 模型、MCP 搜索、RAG）
#   rag-service/.env     （RAG 模型、ES、数据库）
#   frontend/.env        （前端 API 代理）

# OpenAI 配置（历史遗留环境变量，当前后端实际使用 backend/.env 的 SF_API_KEY）
# OPENAI_API_KEY=sk-test-key-placeholder
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4-turbo-preview

# Elasticsearch 密码（与 rag-service/.env 中保持一致）
# ELASTIC_PASSWORD=elastic123456

# 内存限制 / 时区 / 日志级别
# MEM_LIMIT=2g
# TIMEZONE=Asia/Shanghai
# LOG_LEVEL=INFO
